# LocalNewz — Backend environment variables
# Copy this file to .env and fill in production values on your backend hosting platform.
# Never commit real secrets to version control.

MONGO_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/localnews?retryWrites=true&w=majority&appName=LocalNews

PORT=5001
JWT_SECRET=<change-me-in-production>

# Public backend API domain (no trailing slash). Used by the Vercel share function to call the API.
PUBLIC_API_URL=https://api.localnewz.in
BACKEND_URL=https://api.localnewz.in

# Public frontend domain (no trailing slash). Used by /share/news/:slug for the
# article URL / redirect target and Open Graph og:url.
# Must be the real public frontend domain, never localhost in production.
PUBLIC_FRONTEND_URL=https://www.localnewz.in
FRONTEND_URL=https://www.localnewz.in

VAPID_PUBLIC_KEY=<your-vapid-public-key>
VAPID_PRIVATE_KEY=<your-vapid-private-key>
VAPID_SUBJECT=mailto:localnewz2025@gmail.com

RESEND_API_KEY=<your-resend-api-key>
OTP_EXPIRE_MINUTES=10
RESEND_TO_EMAIL=localnewz2025@gmail.com

CLOUDINARY_CLOUD_NAME=<your-cloudinary-cloud-name>
CLOUDINARY_API_KEY=<your-cloudinary-api-key>
CLOUDINARY_API_SECRET=<your-cloudinary-api-secret>

GOOGLE_CLIENT_ID=<your-google-client-id>
