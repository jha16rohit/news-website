# LocalNewz — Frontend environment variables
# Copy this file to .env and fill in production values on your hosting platform (e.g. Vercel).
# Only VITE_* variables are exposed to the browser. Never put secrets here.

# Public backend API base URL (with /api suffix). Used by the frontend to call the API.
VITE_API_URL=https://api.localnewz.com/api

# Public frontend domain. Used to build the public sharing URL (WhatsApp / Copy Link).
# Must be the real public frontend domain, never the backend/API domain.
VITE_FRONTEND_URL=https://www.localnewz.com

VITE_GOOGLE_CLIENT_ID=1015285644057-7d586dc03q3d1k1ksorrhb9tg4bg5n6k.apps.googleusercontent.com
