generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  phone     String?
  role      String   @default("ADMIN")
  createdAt DateTime @default(now())

  news News[]
}

model News {
  id         String  @id @default(uuid())
  headline   String
  shortTitle String?
  excerpt    String?
  content    String

  categoryId String
  category   Category @relation("MainCategory", fields: [categoryId], references: [id])

  categories Category[] @relation("NewsCategories")

  language String  @default("English")
  location String?

  tags NewsTag[]

  articleType ArticleType @default(STANDARD)

  breakingNewsTicker    Boolean @default(false)
  breakingPushNotif     Boolean @default(false)
  breakingHomepageAlert Boolean @default(false)

  expiryTime DateTime?
  priority   Priority?

  liveUpdates Json?

  featuredImage String?
  imageCaption  String?
  photoCredit   String?

  metaTitle       String?
  metaDescription String?

  slug          String   @unique
  keywords      String[]
  focusKeywords String?
  canonicalUrl  String?

  status      Status    @default(DRAFT)
  publishedAt DateTime?
  scheduledAt DateTime?

  deletedAt   DateTime?
  deleteAfter DateTime?

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  topicProfileId String?
  topicProfile   TopicProfile? @relation(fields: [topicProfileId], references: [id])

  readHistory UserReadHistory[]
  bookmarks   Bookmark[]
  comments    Comment[]
  likes       NewsLike[]

  views     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([slug])
  @@index([categoryId])
  @@index([publishedAt])
  @@index([createdAt])
  @@index([status])
  @@index([authorId])
}

model TopicProfile {
  id          String  @id @default(uuid())
  name        String
  slug        String  @unique
  caption     String?
  description String

  instagram String?
  facebook  String?
  twitter   String?

  imageUrl String?

  createdAt DateTime @default(now())

  news News[]
}

model Category {
  id          String  @id @default(uuid())
  name        String
  slug        String  @unique
  description String?
  color       String?

  parentId String?
  parent   Category?  @relation("CategoryToCategory", fields: [parentId], references: [id])
  children Category[] @relation("CategoryToCategory")

  news       News[] @relation("MainCategory")
  categories News[] @relation("NewsCategories")

  featured Boolean @default(false)
  showcase Boolean @default(false)
  active   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([slug])
  @@index([parentId])
}

model Tag {
  id         String  @id @default(uuid())
  name       String  @unique
  usageCount Int     @default(0)
  slug       String  @unique
  isTrending Boolean @default(false)

  createdAt DateTime @default(now())

  articles NewsTag[]

  @@index([name])
}

model NewsTag {
  id String @id @default(uuid())

  newsId String
  news   News   @relation(fields: [newsId], references: [id], onDelete: Cascade)

  tagId String
  tag   Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([newsId, tagId])
}

model FooterSettings {
  id String @id @default("singleton")

  sectionTitle String @default("STAY UPDATED")

  descriptionText String @default("Get the latest headlines, breaking news, and exclusive updates delivered straight to your inbox.")

  trustedText String @default("Your trusted source for accurate and timely news coverage around the clock.")

  images Json @default("[]")

  updatedAt DateTime @default(now()) @updatedAt
}

model ContactMessage {
  id      String  @id @default(uuid())
  name    String
  email   String
  phone   String?
  subject String?
  message String

  read      Boolean @default(false)
  replied   Boolean @default(false)
  replyText String?

  receivedAt DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt
}

model AdInquiry {
  id      String  @id @default(uuid())
  name    String
  email   String
  phone   String?
  company String?
  message String?
  budget  String?

  targetPage String?
  duration   String?
  customDays Int?
  adType     String?

  imageUrl String?
  linkUrl  String?
  adTitle  String?

  status    AdInquiryStatus @default(pending)
  adminNote String?

  publishedAt DateTime?
  expiresAt   DateTime?

  submittedAt DateTime @default(now())

  publishedAd PublishedAd?
}

model PublishedAd {
  id String @id @default(uuid())

  inquiryId String    @unique
  inquiry   AdInquiry @relation(fields: [inquiryId], references: [id], onDelete: Cascade)

  imageUrl String
  linkUrl  String?
  altText  String?

  targetPage String?
  adTitle    String?
  advertiser String?

  isActive Boolean @default(true)

  publishedAt DateTime
  expiresAt   DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

model AdPageSettings {
  id String @id @default("singleton")

  whyEnabled Boolean @default(true)
  whyPoints  Json    @default("[]")

  packagesEnabled Boolean @default(true)
  packages        Json    @default("[]")

  contactEnabled Boolean @default(true)
  contactEmail   String?
  contactPhone   String?
  contactNote    String?

  updatedAt DateTime @default(now()) @updatedAt
}

model ContactUsSettings {
  id String @id @default("singleton")

  heroVisible  Boolean @default(true)
  heroTitle    String?
  heroSubtitle String?

  contactInfoVisible Boolean @default(true)

  formVisible    Boolean @default(true)
  formTitle      String?
  formSubtitle   String?
  formSuccessMsg String?

  subjectOptions Json?

  faqVisible Boolean @default(true)
  faqTitle   String?

  contactInfo ContactInfo[]
  faq         FAQItem[]

  updatedAt DateTime @default(now()) @updatedAt
}

model ContactInfo {
  id String @id @default(uuid())

  settingsId String
  settings   ContactUsSettings @relation(fields: [settingsId], references: [id], onDelete: Cascade)

  type  String
  label String
  value String

  visible  Boolean @default(true)
  position Int     @default(0)

  updatedAt DateTime @default(now()) @updatedAt
}

model FAQItem {
  id String @id @default(uuid())

  settingsId String
  settings   ContactUsSettings @relation(fields: [settingsId], references: [id], onDelete: Cascade)

  question String
  answer   String

  visible  Boolean @default(true)
  position Int     @default(0)

  updatedAt DateTime @default(now()) @updatedAt
}

model SiteUser {
  id         String  @id @default(uuid())
  name       String
  email      String  @unique
  phone      String?
  password   String?
  googleId   String? @unique
  profilePic String?

  role       Role    @default(USER)
  isVerified Boolean @default(false)

  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @default(now()) @updatedAt
  readHistory UserReadHistory[]
  bookmarks   Bookmark[]
  comments    Comment[]
  likes       NewsLike[]

  @@index([email])
}

model UserReadHistory {
  id String @id @default(uuid())

  userId String
  newsId String

  user SiteUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  news News     @relation(fields: [newsId], references: [id], onDelete: Cascade)

  readAt DateTime @default(now())

  @@unique([userId, newsId])
}

model Bookmark {
  id String @id @default(uuid())

  userId String
  newsId String

  user SiteUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  news News     @relation(fields: [newsId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, newsId])
}

model Comment {
  id String @id @default(uuid())

  content String

  userId String
  newsId String

  user SiteUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  news News     @relation(fields: [newsId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model NewsLike {
  id String @id @default(uuid())

  userId String
  newsId String

  user SiteUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  news News     @relation(fields: [newsId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, newsId])
}

enum ArticleType {
  STANDARD
  BREAKING
  LIVE
}

enum Status {
  DRAFT
  PUBLISHED
  SCHEDULED
  EXPIRED
  DELETED
  ARCHIVED
}

enum Priority {
  CRITICAL
  HIGH
  MEDIUM
}

enum AdInquiryStatus {
  pending
  reviewed
  approved
  published
  rejected
}

enum Role {
  USER
  ADMIN
  EDITOR
}
